TTS_MODEL=tts-1
TTS_MAX_CHARACTERS=3800
STORY_AI_API_KEY=
STORY_AI_BASE_URL=https://api.openai.com/v1/chat/completions
STORY_AI_MODEL=
STORY_AI_TIMEOUT_MS=90000
