PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://storyloom:storyloom@localhost:5432/storyloom
SESSION_COOKIE_NAME=storyloom_session
SESSION_TTL_DAYS=30
ADMIN_EMAILS=admin@example.com
AUTO_MIGRATE=true
DEV_EXPOSE_VERIFICATION_CODE=true
